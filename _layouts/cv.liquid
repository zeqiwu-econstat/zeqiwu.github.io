---
layout: default
---

<div class="post">
  <article>
    <div class="cv">
      <header class="cv-page-header">
        <h1 class="cv-page-title">
          {{ page.title }}
          {% if page.cv_pdf %}
            <a href="{{ page.cv_pdf | prepend: 'assets/' | relative_url }}" target="_blank" rel="noopener noreferrer" class="cv-pdf-link" aria-label="Open CV as PDF"><span class="cv-pdf-label">pdf</span></a>
          {% endif %}
        </h1>
      </header>

      {% assign basics = site.data.cv.basics %}

      {% if basics %}
        <div class="cv-header">
          {% if basics.name %}
            <h2 class="cv-name">{{ basics.name }}</h2>
          {% endif %}

          <div class="cv-contact-bar">
            {% if basics.email %}
              <div class="cv-contact-row">
                <span class="cv-contact-label">Email</span>
                <a href="mailto:{{ basics.email }}" class="cv-contact-link">{{ basics.email }}</a>
              </div>
            {% endif %}
            {% if basics.url %}
              <div class="cv-contact-row">
                <span class="cv-contact-label">Website</span>
                <a href="{{ basics.url }}" target="_blank" rel="noopener noreferrer" class="cv-contact-link">
                  {{- basics.url | remove: 'https://' -}}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if site.data.cv.education %}
        <section class="cv-section mb-5">
          <h2 id="education" class="cv-section-title">Education</h2>
          <div class="cv-entries">
            {% for edu in site.data.cv.education %}
              <div class="cv-card">
                <div class="cv-card-header">
                  <div class="cv-card-left">
                      {% if edu.studyType %}
                        <div class="cv-degree-row">
                          <span class="cv-degree-badge">{{ edu.studyType }}</span>
                        </div>
                      {% endif %}
                    <div class="cv-card-title-line">
                      {% if edu.url %}
                        <a href="{{ edu.url }}" target="_blank" rel="noopener noreferrer" class="cv-institution">{{ edu.institution }}</a>
                      {% else %}
                        <span class="cv-institution">{{ edu.institution }}</span>
                      {% endif %}
                    </div>
                    <div class="cv-card-subtitle">
                      {% if edu.department %}
                        {% if edu.departmentUrl %}
                          <a href="{{ edu.departmentUrl }}" target="_blank" rel="noopener noreferrer" class="cv-department">{{ edu.department }}</a>
                        {% else %}
                          <span class="cv-department">{{ edu.department }}</span>
                        {% endif %}
                      {% endif %}
                      {% if edu.location %}
                        <span class="cv-location">({{ edu.location }})</span>
                      {% endif %}
                    </div>
                  </div>
                  <div class="cv-card-date">
                    {% assign start_str = edu.startDate | date: "%Y.%m" | default: "" %}
                    {% assign end_lc = edu.endDate | downcase | default: "" %}
                    {% if edu.endDate %}
                      {% if end_lc == "present" %}
                        {% assign end_str = "Present" %}
                      {% else %}
                        {% assign end_str = edu.endDate | date: "%Y.%m" | default: "" %}
                      {% endif %}
                    {% else %}
                      {% assign end_str = "" %}
                    {% endif %}
                    {% if start_str != "" and end_str != "" %}
                      {{ start_str }} &ndash; {{ end_str }}
                    {% elsif start_str != "" %}
                      {{ start_str }}
                    {% elsif end_str != "" %}
                      {{ end_str }}
                    {% endif %}
                  </div>
                </div>

                {% assign has_education_details = false %}
                {% if edu.major %}
                  {% assign has_education_details = true %}
                {% endif %}
                {% if edu.fields and edu.fields.size > 0 %}
                  {% assign has_education_details = true %}
                {% endif %}
                {% if has_education_details %}
                  <div class="cv-card-body">
                    <div class="cv-details">
                      {% if edu.major %}
                        <div class="cv-detail-row">
                          <span class="cv-detail-label">Major</span>
                          <span class="cv-detail-value">{{ edu.major }}</span>
                        </div>
                      {% endif %}
                      {% if edu.fields and edu.fields.size > 0 %}
                        <div class="cv-detail-row">
                          <span class="cv-detail-label">Fields</span>
                          <span class="cv-detail-value">{{ edu.fields | join: ", " }}</span>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if site.data.cv.research_interests and site.data.cv.research_interests.size > 0 %}
        <section class="cv-section mb-5">
          <h2 id="research-interests" class="cv-section-title">Research Interests</h2>
          <div class="cv-tags">
            {% for interest in site.data.cv.research_interests %}
              <span class="cv-tag">{{ interest }}{% unless forloop.last %},{% endunless %}</span>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if site.data.cv.skills %}
        <section class="cv-section mb-5">
          <h2 id="skills" class="cv-section-title">Skills</h2>
          <div class="cv-skills">
            {% if site.data.cv.skills.programming and site.data.cv.skills.programming.size > 0 %}
              <div class="cv-skill-row">
                <span class="cv-skill-label">Programming</span>
                <span class="cv-skill-value">{{ site.data.cv.skills.programming | join: ", " }}</span>
              </div>
            {% endif %}
            {% if site.data.cv.skills.other and site.data.cv.skills.other.size > 0 %}
              <div class="cv-skill-row">
                <span class="cv-skill-label">Other</span>
                <span class="cv-skill-value">{{ site.data.cv.skills.other | join: ", " }}</span>
              </div>
            {% endif %}
          </div>
        </section>
      {% endif %}

      {% if site.data.cv.languages %}
        <section class="cv-section mb-5">
          <h2 id="languages" class="cv-section-title">Languages</h2>
          <div class="cv-inline-list">
            {% for lang in site.data.cv.languages %}
              <span class="cv-inline-item">
                <span class="cv-inline-key">{{ lang.language }}</span>
                {% if lang.fluency %}
                  <span class="cv-inline-val">({{ lang.fluency }})</span>
                {% endif %}
              </span>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    </div>
  </article>
</div>
