---
layout: default
---

<div class="post">
  <article>
    <div class="talks">
      <header class="talks-page-header">
        <h1 class="talks-page-title">{{ page.title }}</h1>
        {% if page.description and page.description != "" %}
          <p class="talks-description">{{ page.description }}</p>
        {% endif %}
      </header>

      {% if site.data.talks.talks %}
        <div class="talks-list">
          {% for talk in site.data.talks.talks %}
            <div class="talk-card">
              <div class="talk-title">{{ talk.title }}</div>
              <div class="talk-meta">
                {% if talk.location %}<span class="talk-location">{{ talk.location }}</span>{% endif %}
                <span class="talk-date">{% if talk.location %}({% endif %}{{ talk.date | date: "%b %Y" }}{% if talk.location %}){% endif %}</span>
                {% if talk.slides or talk.video or talk.abstract %}
                  <span class="talk-links">
                    {% if talk.slides %}
                      <a href="{{ talk.slides | relative_url }}" target="_blank" rel="noopener noreferrer" class="talk-link-btn">
                        <span class="talk-link-label">click for slides</span>
                      </a>
                    {% endif %}
                    {% if talk.video %}
                      <a href="{{ talk.video }}" target="_blank" rel="noopener noreferrer" class="talk-link-btn">
                        <span class="talk-link-label">video</span>
                      </a>
                    {% endif %}
                  </span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </article>
</div>
